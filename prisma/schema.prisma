generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CUSTOMER
  ADMIN
}

enum BookingStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id           String    @id @default(cuid())
  fullName     String
  email        String    @unique
  passwordHash String?
  googleId     String?   @unique
  avatarUrl    String?
  phoneNumber  String?
  country      String?
  bio          String?
  role         UserRole  @default(CUSTOMER)
  bookings     Booking[]
  sessions     Session[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([userId])
  @@index([expiresAt])
}

model Booking {
  id          String        @id @default(cuid())
  destination String
  packageName String
  startDate   DateTime
  people      Int
  notes       String?
  status      BookingStatus @default(PENDING)
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([userId])
  @@index([status])
}

model Package {
  id         String   @id
  name       String
  image      String?
  duration   String
  altitude   String
  difficulty String
  idealFor   String
  summary    String
  pricing    Json
  itinerary  Json
  includes   Json
  excludes   Json
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Destination {
  id               String   @id
  name             String
  image            String
  region           String
  duration         String
  elevation        String
  lat              Float
  lng              Float
  desc             String
  difficulty       String
  bestSeason       String
  permits          String
  mapCenter        Json
  mapZoom          Int
  trailCoordinates Json
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}
